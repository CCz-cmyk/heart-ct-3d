{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "0. 准备 MySQL ASCII 链接",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "$l = Join-Path $env:TEMP 'heart3d-workspace'; if (-not (Test-Path -LiteralPath $l)) { New-Item -ItemType Junction -Path $l -Target '${workspaceFolder}' | Out-Null; Write-Host \"Created junction: $l\" } else { Write-Host \"Junction exists: $l\" }"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "heart3d"
      }
    },
    {
      "label": "1. MySQL 数据库 (3306)",
      "type": "process",
      "command": "${env:TEMP}\\heart3d-workspace\\_tools\\mysql_extract\\mysql-8.0.42-winx64\\bin\\mysqld.exe",
      "args": [
        "--basedir=${env:TEMP}\\heart3d-workspace\\_tools\\mysql_extract\\mysql-8.0.42-winx64",
        "--datadir=${env:TEMP}\\heart3d-workspace\\mysql-data",
        "--port=3306"
      ],
      "dependsOn": ["0. 准备 MySQL ASCII 链接"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "group": "heart3d"
      }
    },
    {
      "label": "2. 后端 API (8000)",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "heart3d"
      }
    },
    {
      "label": "3. 前端 Vite (5176)",
      "type": "process",
      "command": "${workspaceFolder}\\_tools\\node_extract\\node-v22.23.4-win-x64\\node.exe",
      "args": [
        "node_modules/vite/bin/vite.js",
        "--port",
        "5176",
        "--strictPort"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "heart3d"
      }
    },
    {
      "label": "启动全部服务（点这个）",
      "dependsOrder": "parallel",
      "dependsOn": [
        "1. MySQL 数据库 (3306)",
        "2. 后端 API (8000)",
        "3. 前端 Vite (5176)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "停止全部服务",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "foreach($p in 3306,8000,5176){ Get-NetTCPConnection -LocalPort $p -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue } }; Write-Host 'All Heart3D services stopped.'"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "heart3d"
      },
      "problemMatcher": []
    }
  ]
}
